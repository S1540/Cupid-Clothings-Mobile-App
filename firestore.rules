rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Candidate migration rules: compare with deployed rules before rollout.
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/accountDeletions/$(uid));
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow list, create, update, delete: if false;
      match /orders/{id} { allow read: if owner(uid); allow write: if false; }
      match /coupons/{id} { allow read: if owner(uid); allow write: if false; }
      match /cart/{id} { allow read, write: if owner(uid); }
      match /wishlist/{id} { allow read, write: if owner(uid); }
      match /address/{id} { allow read, write: if owner(uid); }
    }
    match /judgeme/{id} { allow read: if true; allow write: if false; }
    match /judgemeReviews/{id} { allow read: if true; allow write: if false; }
    // All identity mappings, unresolved payloads, deletion jobs and rewards
    // are Admin-only. No email-based enumeration from the mobile client.
    match /{document=**} { allow read, write: if false; }
  }
}
