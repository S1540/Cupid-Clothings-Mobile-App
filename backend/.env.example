# Do not copy secrets into source control. Existing Firebase/Shopify settings
# must retain their current project and store identities.
SHOPIFY_WEBHOOK_SECRET=
SHIPROCKET_WEBHOOK_TOKEN=
# Operational switch: false pauses new checkouts; existing orders still process.
# Enabling this does not certify live provider behavior.
CHECKOUT_ENABLED=true
# SHIPROCKET_WEBHOOK_VALIDATED / CHECKOUT_ASSOCIATION_VALIDATED are retired.
# Authentication always requires the correct webhook token/signature.
# Optional override; otherwise uses existing SHOPIFY_STORE / SHOPIFY_SHOP.
SHOPIFY_STOREFRONT_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# Optional override; default 2026-01 (read-only store query verified).
SHOPIFY_STOREFRONT_API_VERSION=2026-01
